{
  "name": "@thabet/react-data-kit",
  "version": "0.1.0",
  "description": "React data kit: datatable, query table, dynamic forms, CRUD, infinite scroll — TypeScript, Ant Design, React Hook Form",
  "license": "MIT",
  "author": "Thabet Khiari",
  "repository": {
    "type": "git",
    "url": "https://github.com/thabet/react-data-kit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^3.3.0 || ^4.0.0 || ^5.0.0",
    "antd": ">=5.12.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-hook-form": "^7.50.0",
    "yup": "^1.3.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "antd": "^5.24.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "yup": "^1.6.1"
  }
}
