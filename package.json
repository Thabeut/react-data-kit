{
  "name": "@thabeut/react-data-kit",
  "version": "0.1.0",
  "description": "React data kit: datatable, query table, dynamic forms, CRUD, infinite scroll — TypeScript, Ant Design, React Hook Form",
  "license": "MIT",
  "author": "Thabet Khiari",
  "repository": {
    "type": "git",
    "url": "https://github.com/thabeut/react-data-kit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "playground:dev": "npm run dev -w react-data-kit-playground",
    "playground:build": "npm run build -w react-data-kit-playground",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^3.3.0 || ^4.0.0 || ^5.0.0",
    "@iconify/react": ">=4.0.0",
    "antd": ">=5.12.0",
    "clsx": ">=2.0.0",
    "dayjs": ">=1.11.0",
    "i18next": ">=23.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-hook-form": "^7.50.0",
    "react-i18next": ">=15.0.0",
    "yup": "^1.3.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@iconify/react": "^5.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "antd": "^5.24.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "esbuild-sass-plugin": "^3.7.0",
    "i18next": "^24.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.1",
    "sass": "^1.98.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "yup": "^1.6.1"
  }
}
