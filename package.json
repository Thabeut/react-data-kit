{
  "name": "@thabeut/react-data-kit",
  "version": "0.1.4",
  "description": "React data kit: datatable, query table, dynamic forms, CRUD, infinite scroll — TypeScript, Ant Design, React Hook Form",
  "keywords": [
    "react",
    "typescript",
    "antd",
    "data-table",
    "query-table",
    "dynamic-form",
    "crud",
    "infinite-scroll",
    "react-hook-form"
  ],
  "license": "MIT",
  "author": "Thabet Khiari",
  "repository": {
    "type": "git",
    "url": "https://github.com/thabeut/react-data-kit.git"
  },
  "homepage": "https://react-data-kit.vercel.app/",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": {
      "import": "./dist/index.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "playground:dev": "npm run dev -w react-data-kit-playground",
    "playground:build": "npm run build -w react-data-kit-playground"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "antd": ">=5 <6",
    "react-hook-form": ">=7 <8",
    "@hookform/resolvers": ">=3 <6",
    "yup": ">=1 <2",
    "dayjs": ">=1 <2",
    "clsx": ">=2 <3",
    "i18next": ">=23 <25",
    "react-i18next": ">=15 <16",
    "@iconify/react": ">=5 <6"
  },
  "devDependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "antd": "5.24.3",
    "react-hook-form": "7.72.0",
    "@hookform/resolvers": "5.2.2",
    "yup": "1.6.1",
    "dayjs": "1.11.20",
    "clsx": "2.1.1",
    "i18next": "24.2.3",
    "react-i18next": "15.4.1",
    "@iconify/react": "5.2.0",
    "typescript": "^5.8.2",
    "tsup": "^8.4.0",
    "sass": "^1.98.0",
    "esbuild-sass-plugin": "^3.7.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"
  }
}
